  <key>GIDClientID</key><string>$(GOOGLE_IOS_CLIENT_ID)</string>
  <key>CFBundleURLTypes</key><array><dict><key>CFBundleURLSchemes</key><array><string>$(GOOGLE_REVERSED_CLIENT_ID)</string></array></dict></array>
